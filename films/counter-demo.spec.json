{
  "id": "counter-demo",
  "title": "反例：一个停在同一个尺度上的片子（解析器应该拒绝）",
  "duration": 24,
  "fps": 60,
  "aspect": "16:9",
  "genre": "build",
  "palette": ["#8a7a64", "#8dc45c", "#4a5a6a"],
  "accent": "#ffd08a",
  "ladder": ["object", "cluster", "field", "world"],
  "cast": [{ "id": "hero", "kind": "figure", "opts": { "scale": 1 } }],
  "stages": [
    { "id": "hook",  "t": [0, 3],   "role": "hook",  "verb": "看着空地", "scale": "cluster",
      "change": { "kind": "none", "count": 0, "what": "" },
      "camera": { "from": [0, 1.4, 5], "to": [0, 1.4, 5.1], "look": [0, 1, -3], "fov": 40 },
      "light": { "time": "day", "key": 1 }, "caption": { "zh": "空地。", "en": "Empty." }, "sfx": [] },

    { "id": "setup", "t": [3, 7],   "role": "setup", "verb": "拿起工具", "scale": "cluster",
      "change": { "kind": "gesture", "count": 1, "what": "拿起铲子" },
      "camera": { "from": [0, 1.4, 5.1], "to": [0, 1.4, 5], "look": [0, 1, -3], "fov": 40 },
      "light": { "time": "day", "key": 1 }, "caption": { "zh": "", "en": "" }, "sfx": [["tick", 3.2]] },

    { "id": "first", "t": [7, 11],  "role": "first-unit", "verb": "种一棵树", "scale": "cluster",
      "change": { "kind": "increment", "count": 1, "what": "一棵树" },
      "camera": { "from": [0, 1.3, 4], "to": [0, 1.3, 4], "look": [0, 1, -3], "fov": 40 },
      "light": { "time": "day", "key": 1 }, "caption": { "zh": "", "en": "" }, "sfx": [["pop", 7.4]] },

    { "id": "build", "t": [11, 19], "role": "accumulation", "verb": "一直种树", "scale": "cluster",
      "change": { "kind": "increment", "count": 3, "what": "再种三棵" },
      "camera": { "from": [0, 1.3, 4], "to": [0, 1.3, 4], "look": [0, 1, -3], "fov": 40 },
      "light": { "time": "day", "key": 1 }, "caption": { "zh": "", "en": "" }, "sfx": [["pop", 13], ["pop", 15]] },

    { "id": "payoff", "t": [19, 22], "role": "payoff", "verb": "再多一棵", "scale": "cluster",
      "change": { "kind": "increment", "count": 1, "what": "一棵" },
      "camera": { "from": [0, 1.3, 4], "to": [0, 1.3, 4], "look": [0, 1, -3], "fov": 40 },
      "light": { "time": "day", "key": 1 }, "caption": { "zh": "", "en": "" }, "sfx": [] },

    { "id": "button", "t": [22, 24], "role": "button", "verb": "停住", "scale": "cluster",
      "change": { "kind": "hold", "count": 1, "what": "停住" },
      "camera": { "from": [0, 1.3, 4], "to": [0, 1.3, 4], "look": [0, 1, -3], "fov": 40 },
      "light": { "time": "day", "key": 1 }, "caption": { "zh": "种完了。", "en": "Done." }, "sfx": [] }
  ]
}
